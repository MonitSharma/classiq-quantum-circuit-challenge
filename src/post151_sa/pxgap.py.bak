"""Find x loaders whose px-holding wire (coord 1) has a positive value-fixed gap,
while keeping the ready vector tight.  That is what could push the refined bound to 114."""
import pickle, sys, glob, os
sys.path.insert(0, '.')
from lbeval2 import load_beam, sa4
from sim import check_loader2
from depth import gate_depth
from kdrv import profile, full_gates
from kgen import side_plan
files = sorted(set(f for p in sys.argv[1:] for f in glob.glob(p)))
D = pickle.load(open('runs/s118x.pkl', 'rb'))

def sgap(g):
    wt = [0]*9; lu = [False]*9; tgt = [-1]*9
    for x in g:
        if x[0][0] == 'cx':
            c, t = x[1], x[2]; m = max(wt[c], wt[t]) + 1; wt[c] = wt[t] = m; lu[c] = lu[t] = False; tgt[t] = m
        else:
            w = x[1]
            if not lu[w]: wt[w] += 1; lu[w] = True
    return wt, tgt

rows = []
for p in files:
    try:
        bd, seq = load_beam(p)
        if not seq: continue
        d, pen, g = sa4(D, seq, tag='px', binary='./c/sa4')
        chk = check_loader2(g, D['newcode'])
        if pen != 0 or chk['max_dev'] > 1e-9: continue
        e, _ = profile(g)
        fx, W, co, rdy = side_plan(g, e, D, 0)
        if len(rdy) < 4 or 1 not in co: continue
        wt, tgt = sgap({'gates': g, 'fix': []})
        i = co.index(1)                      # the px wire
        w = W[i]
        gap = e[w] - (tgt[w] if tgt[w] >= 0 else e[w])
        others = [rdy[j] for j in range(4) if j != i]
        rows.append((gap, max(rdy), rdy[i], sum(rdy), os.path.basename(p), W, rdy, co))
    except Exception:
        continue
rows.sort(key=lambda t: (-t[0], t[1], t[3]))
print(f'{len(rows)} valid x loaders with a px wire; best px-gap first')
for gap, mx, rpx, sm, p, W, rdy, co in rows[:10]:
    print(f'  px-gap {gap} rdy(px) {rpx} max-rdy {mx} sum {sm} W {W} rdy {rdy} coords {co}  {p}')
