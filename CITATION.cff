    given-names: Monit
type: software
license: MIT
date-released: 2026-09-25
repository-code: "https://github.com/MonitSharma/classiq"
keywords:
  - quantum computing
  - quantum circuit synthesis
  - phase oracle
  - circuit depth optimization
